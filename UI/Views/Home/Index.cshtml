@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        :root {
            --lg-primary: #087c8f;
            --lg-secondary: #6fbd63;
            --lg-dark: #243044;
            --lg-muted: #7d8797;
            --lg-border: #e5edf1;
        }

        .dashboard-page {
            min-height: calc(100vh - 90px);
            padding: 34px;
            border-radius: 32px;
            background: radial-gradient(circle at top left, rgba(111,189,99,.26), transparent 34%), radial-gradient(circle at top right, rgba(8,124,143,.20), transparent 32%), linear-gradient(135deg, #f8fffc 0%, #eef8f6 42%, #f7fbff 100%);
        }

        .dashboard-hero {
            padding: 32px;
            margin-bottom: 26px;
            border-radius: 30px;
            color: #fff;
            background: linear-gradient(135deg, #087c8f, #159d98, #6fbd63);
            box-shadow: 0 22px 55px rgba(8,124,143,.24);
        }

        .hero-kicker {
            display: inline-flex;
            gap: 8px;
            align-items: center;
            padding: 8px 14px;
            margin-bottom: 14px;
            border-radius: 999px;
            background: rgba(255,255,255,.18);
            font-weight: 800;
            font-size: 13px;
        }

        .hero-title {
            font-size: 34px;
            font-weight: 900;
            margin-bottom: 8px;
        }

        .hero-subtitle {
            max-width: 760px;
            margin: 0;
            opacity: .94;
        }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 22px;
        }

        .stat-card,
        .dash-card {
            border: 1px solid rgba(255,255,255,.72);
            border-radius: 26px;
            background: rgba(255,255,255,.82);
            box-shadow: 0 18px 42px rgba(32,52,70,.09);
            backdrop-filter: blur(16px);
        }

        .stat-card {
            padding: 22px;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            color: #fff;
            background: linear-gradient(135deg, var(--lg-primary), var(--lg-secondary));
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 14px;
            font-size: 20px;
        }

        .stat-label {
            color: var(--lg-muted);
            font-size: 13px;
            font-weight: 800;
        }

        .stat-value {
            color: var(--lg-dark);
            font-size: 28px;
            font-weight: 900;
        }

        .dash-card {
            overflow: hidden;
            height: 100%;
        }

        .dash-card-header {
            padding: 22px 24px;
            border-bottom: 1px solid rgba(229,237,241,.75);
        }

        .dash-card-body {
            padding: 22px 24px 24px;
        }

        .section-title {
            color: var(--lg-dark);
            font-weight: 900;
            margin-bottom: 4px;
        }

        .section-desc {
            color: var(--lg-muted);
            font-size: 14px;
            margin: 0;
        }

        .leader-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 0;
            border-bottom: 1px solid #edf1f4;
        }

        .rank {
            width: 40px;
            height: 40px;
            border-radius: 14px;
            color: #fff;
            background: linear-gradient(135deg, var(--lg-primary), var(--lg-secondary));
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
        }

        .leader-name {
            color: var(--lg-dark);
            font-weight: 900;
        }

        .leader-sub {
            color: var(--lg-muted);
            font-size: 13px;
        }

        .score-badge {
            margin-left: auto;
            padding: 8px 12px;
            border-radius: 999px;
            background: rgba(8,124,143,.08);
            color: var(--lg-primary);
            font-weight: 900;
        }

        .progress-box {
            margin-bottom: 18px;
        }

        .progress-title {
            display: flex;
            justify-content: space-between;
            color: var(--lg-dark);
            font-weight: 900;
            margin-bottom: 8px;
        }

        .progress {
            height: 12px;
            border-radius: 999px;
            background: #e8f1f3;
        }

        .progress-bar {
            border-radius: 999px;
            background: linear-gradient(135deg, var(--lg-primary), var(--lg-secondary));
        }

        .activity-item {
            display: flex;
            gap: 12px;
            padding: 14px 0;
            border-bottom: 1px solid #edf1f4;
        }

        .activity-icon {
            width: 42px;
            height: 42px;
            min-width: 42px;
            border-radius: 15px;
            color: #fff;
            background: linear-gradient(135deg, var(--lg-primary), var(--lg-secondary));
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .activity-title {
            color: var(--lg-dark);
            font-weight: 900;
        }

        .activity-desc {
            color: var(--lg-muted);
            font-size: 13px;
        }

        .dist-row {
            margin-bottom: 16px;
        }

        .dist-label {
            display: flex;
            justify-content: space-between;
            color: var(--lg-dark);
            font-weight: 800;
            margin-bottom: 7px;
        }

        @@media(max-width: 1200px) {
            .stat-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media(max-width: 768px) {
            .dashboard-page {
                padding: 18px;
            }

            .stat-grid {
                grid-template-columns: 1fr;
            }

            .hero-title {
                font-size: 26px;
            }
        }
    </style>
}

<div id="app" class="dashboard-page">

    <div class="dashboard-hero">
        <div class="hero-kicker">
            <i class="fa fa-chart-line"></i>
            Yönetim Özeti
        </div>

        <h1 class="hero-title">Dashboard</h1>

        <p class="hero-subtitle">
            Öğrencilerin simülasyon, çözümleme ve soru cevap performanslarını tek ekrandan takip edin.
        </p>
    </div>

    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-icon"><i class="fa fa-users"></i></div>
            <div class="stat-label">Toplam Öğrenci</div>
            <div class="stat-value">{{ dashboard.totalStudentCount }}</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon"><i class="fa fa-check-circle"></i></div>
            <div class="stat-label">Simülasyon Tamamlayan</div>
            <div class="stat-value">{{ dashboard.simulationCompletedCount }}</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon"><i class="fa fa-clipboard-check"></i></div>
            <div class="stat-label">Çözümleme Tamamlayan</div>
            <div class="stat-value">{{ dashboard.analysisCompletedCount }}</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon"><i class="fa fa-star"></i></div>
            <div class="stat-label">Ortalama Puan</div>
            <div class="stat-value">{{ dashboard.averageScore }}</div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-8">
            <div class="dash-card">
                <div class="dash-card-header">
                    <h5 class="section-title">Öğrenci Puan Sıralaması</h5>
                    <p class="section-desc">En yüksek toplam puana sahip öğrenciler.</p>
                </div>

                <div class="dash-card-body">
                    <div v-for="(user, index) in dashboard.topUsers" :key="user.userId" class="leader-item">
                        <div class="rank">{{ index + 1 }}</div>

                        <div>
                            <div class="leader-name">{{ user.fullName || '-' }}</div>
                            <div class="leader-sub">
                                Öğrenci No: {{ user.ogrenciNo || '-' }} |
                                Doğru: {{ user.correctCount }} |
                                Yanlış: {{ user.wrongCount }} |
                                Başarı: %{{ user.successRate }}
                            </div>
                        </div>

                        <div class="score-badge">
                            {{ user.totalScore }} Puan
                        </div>
                    </div>

                    <div v-if="!dashboard.topUsers || dashboard.topUsers.length === 0" class="text-muted">
                        Henüz puan verisi bulunamadı.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="dash-card">
                <div class="dash-card-header">
                    <h5 class="section-title">Tamamlanma Oranları</h5>
                    <p class="section-desc">Süreç ilerleme yüzdeleri.</p>
                </div>

                <div class="dash-card-body">
                    <div class="progress-box">
                        <div class="progress-title">
                            <span>Simülasyon</span>
                            <span>%{{ dashboard.simulationCompletedRate }}</span>
                        </div>

                        <div class="progress">
                            <div class="progress-bar" :style="{ width: dashboard.simulationCompletedRate + '%' }"></div>
                        </div>
                    </div>

                    <div class="progress-box">
                        <div class="progress-title">
                            <span>Çözümleme</span>
                            <span>%{{ dashboard.analysisCompletedRate }}</span>
                        </div>

                        <div class="progress">
                            <div class="progress-bar" :style="{ width: dashboard.analysisCompletedRate + '%' }"></div>
                        </div>
                    </div>

                    <div class="progress-box">
                        <div class="progress-title">
                            <span>Genel Başarı</span>
                            <span>%{{ dashboard.successRate }}</span>
                        </div>

                        <div class="progress">
                            <div class="progress-bar" :style="{ width: dashboard.successRate + '%' }"></div>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <strong>Toplam Cevap</strong>
                        <span>{{ dashboard.totalAnswerCount }}</span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <strong>Doğru Cevap</strong>
                        <span>{{ dashboard.correctAnswerCount }}</span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <strong>Yanlış Cevap</strong>
                        <span>{{ dashboard.wrongAnswerCount }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-5">
            <div class="dash-card">
                <div class="dash-card-header">
                    <h5 class="section-title">Puan Dağılımı</h5>
                    <p class="section-desc">Öğrencilerin başarı aralıkları.</p>
                </div>

                <div class="dash-card-body">
                    <div v-for="item in dashboard.scoreDistribution" :key="item.label" class="dist-row">
                        <div class="dist-label">
                            <span>{{ item.label }}</span>
                            <span>{{ item.count }} öğrenci</span>
                        </div>

                        <div class="progress">
                            <div class="progress-bar" :style="{ width: getDistributionRate(item.count) + '%' }"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-7">
            <div class="dash-card">
                <div class="dash-card-header">
                    <h5 class="section-title">Son Aktiviteler</h5>
                    <p class="section-desc">Sistemdeki son cevap ve çözümleme hareketleri.</p>
                </div>

                <div class="dash-card-body">
                    <div v-for="item in dashboard.recentActivities" :key="item.userId + item.description + item.date" class="activity-item">
                        <div class="activity-icon">
                            <i class="fa fa-bolt"></i>
                        </div>

                        <div>
                            <div class="activity-title">
                                {{ item.fullName || '-' }} — {{ item.activityType }}
                            </div>
                            <div class="activity-desc">
                                {{ item.description }}
                            </div>
                            <div class="activity-desc">
                                {{ formatDate(item.date) }}
                            </div>
                        </div>
                    </div>

                    <div v-if="!dashboard.recentActivities || dashboard.recentActivities.length === 0" class="text-muted">
                        Henüz aktivite bulunamadı.
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/page-js/home/dashboard.js"></script>
}