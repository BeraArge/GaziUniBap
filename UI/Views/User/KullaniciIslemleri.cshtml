@{
    ViewData["Title"] = "Kullanıcı İşlemleri";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --lg-primary: #087c8f;
        --lg-secondary: #6fbd63;
        --lg-soft: #eef9f5;
        --lg-dark: #2f3a4a;
        --lg-muted: #8b95a7;
    }

    .lymph-page {
        min-height: calc(100vh - 140px);
    }

    .lymph-hero {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        padding: 32px;
        margin-bottom: 28px;
        background: linear-gradient(135deg, #087c8f 0%, #28a49a 48%, #6fbd63 100%);
        color: #fff;
        box-shadow: 0 18px 45px rgba(8, 124, 143, .22);
    }

        .lymph-hero::after {
            content: "";
            position: absolute;
            right: -70px;
            top: -80px;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .16);
        }

    .hero-title {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .hero-subtitle {
        opacity: .92;
        max-width: 620px;
        margin-bottom: 0;
    }

    .hero-logo-mark {
        width: 86px;
        height: 86px;
        border-radius: 24px;
        background: rgba(255, 255, 255, .95);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 12px 30px rgba(0, 0, 0, .12);
    }

        .hero-logo-mark img {
            width: 68px;
            height: 68px;
            object-fit: contain;
        }

    .lg-card {
        border: 0;
        border-radius: 26px;
        background: rgba(255, 255, 255, .92);
        box-shadow: 0 14px 35px rgba(31, 45, 61, .08);
    }

    .lg-card-header {
        padding: 24px 26px 0;
    }

    .lg-card-body {
        padding: 24px 26px 26px;
    }

    .section-title {
        color: var(--lg-dark);
        font-weight: 700;
        margin-bottom: 4px;
    }

    .section-desc {
        color: var(--lg-muted);
        font-size: 14px;
        margin-bottom: 0;
    }

    .lg-input,
    .lg-select {
        border-radius: 16px;
        border: 1px solid #e4eaf1;
        padding: 12px 15px;
        background-color: #fbfdff;
    }

        .lg-input:focus,
        .lg-select:focus {
            border-color: var(--lg-primary);
            box-shadow: 0 0 0 .18rem rgba(8, 124, 143, .12);
        }

    .btn-lymph {
        border: 0;
        border-radius: 999px;
        padding: 11px 24px;
        color: #fff;
        font-weight: 600;
        background: linear-gradient(135deg, var(--lg-primary), var(--lg-secondary));
        box-shadow: 0 10px 22px rgba(8, 124, 143, .22);
    }

        .btn-lymph:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 14px 28px rgba(8, 124, 143, .28);
        }

    .filter-chip {
        border: 1px solid #dfe8ef;
        background: #fff;
        border-radius: 999px;
        padding: 9px 16px;
        color: #637083;
        font-weight: 500;
    }

        .filter-chip.active {
            color: #fff;
            border-color: transparent;
            background: linear-gradient(135deg, var(--lg-primary), var(--lg-secondary));
        }

    .lg-table {
        border-collapse: separate;
        border-spacing: 0 12px;
    }

        .lg-table thead th {
            border: 0;
            color: #8b95a7;
            font-size: 13px;
            font-weight: 700;
            padding: 0 18px 8px;
            white-space: nowrap;
        }

        .lg-table tbody tr {
            background: #fff;
            box-shadow: 0 8px 20px rgba(31, 45, 61, .055);
        }

        .lg-table tbody td {
            border: 0;
            padding: 18px;
            vertical-align: middle;
        }

            .lg-table tbody td:first-child {
                border-top-left-radius: 18px;
                border-bottom-left-radius: 18px;
            }

            .lg-table tbody td:last-child {
                border-top-right-radius: 18px;
                border-bottom-right-radius: 18px;
            }

    .user-avatar {
        width: 44px;
        height: 44px;
        min-width: 44px;
        border-radius: 15px;
        background: linear-gradient(135deg, rgba(8,124,143,.12), rgba(111,189,99,.18));
        color: var(--lg-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .role-badge {
        border-radius: 999px;
        padding: 8px 13px;
        background: var(--lg-soft);
        color: var(--lg-primary);
        font-weight: 700;
        font-size: 13px;
    }

    .status-ok {
        color: #229b60;
        background: #eaf8f0;
        border-radius: 999px;
        padding: 7px 12px;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-no {
        color: #cf3d3d;
        background: #fff0f0;
        border-radius: 999px;
        padding: 7px 12px;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

    .lg-alert {
        display: flex;
        align-items: center;
        background: linear-gradient(135deg, rgba(8,124,143,0.08), rgba(111,189,99,0.12));
        border: 1px solid rgba(111,189,99,0.25);
        color: #2f6f5f;
        border-radius: 16px;
        padding: 12px 14px;
        font-size: 14px;
        font-weight: 500;
    }

    .btn-sm {
        font-size: 12px;
        padding: 6px 12px;
    }

    .btn i {
        font-size: 12px;
    }

    .user-action-buttons {
        display: flex !important;
        flex-direction: column !important;
        align-items: flex-end !important;
    }

    .action-row {
        display: flex !important;
        gap: 8px !important;
        justify-content: flex-end !important;
        flex-wrap: nowrap !important;
    }

        .action-row .btn,
        .action-row a.btn {
            min-width: 115px !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

    @@media(max-width: 768px) {
        .lymph-page {
            padding: 24px 16px;
        }

        .lymph-hero {
            padding: 24px;
        }

        .hero-title {
            font-size: 24px;
        }

        .action-row {
            flex-wrap: wrap !important;
        }
    }
</style>

<div id="app" class="lymph-page mb-5 mt-1">

    <div class="lymph-hero">
        <div class="d-flex justify-content-between align-items-center position-relative">
            <div>
                <h1 class="hero-title">Kullanıcı İşlemleri</h1>
                <p class="hero-subtitle">
                    Admin ve öğrenci hesaplarını buradan yönetebilir, temel bilgileri düzenleyebilir
                    ve şifre sıfırlama işlemlerini hızlıca yapabilirsiniz.
                </p>
            </div>

            <div class="hero-logo-mark d-none d-md-flex">
                <img src="~/theme/velzon/assets/images/logo-dark.png" alt="LymphGuide" height="150" />
            </div>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-xl-12">
            <div class="lg-card h-100">
                <div class="lg-card-header">
                    <h5 class="section-title">
                        <i class="fa fa-user-plus me-2 text-success"></i>
                        {{ form.id ? 'Kullanıcı Güncelle' : 'Yeni Kullanıcı' }}
                    </h5>
                    <p class="section-desc">
                        Admin veya öğrenci rolüyle kullanıcı oluşturun. Öğrenciye özel alanlar rol seçimine göre açılır.
                    </p>
                </div>

                <div class="lg-card-body">

                    <div class="lg-alert mb-3">
                        <i class="fa fa-info-circle me-2"></i>
                        Kullanıcı şifresi otomatik olarak <strong class="mx-1">123123Aa</strong> oluşturulur.
                        Simülasyon, çözümleme ve toplam puan bilgileri bu ekrandan güncellenemez.
                    </div>

                    <div class="row">
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label">Ad</label>
                                <input class="form-control lg-input"
                                       v-model="form.name"
                                       placeholder="Ad" />
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label">Soyad</label>
                                <input class="form-control lg-input"
                                       v-model="form.surname"
                                       placeholder="Soyad" />
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label">Telefon Numarası</label>
                                <input class="form-control lg-input"
                                       v-model="form.phone"
                                       @@input="formatPhone"
                                       placeholder="5XXXXXXXXX" />
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label">Rol</label>
                                <select class="form-select lg-select" v-model="form.roleId">
                                    <option value="">Rol seçiniz</option>
                                    <option v-for="role in roles"
                                            :key="role.id"
                                            :value="role.id">
                                        {{ role.name }}
                                    </option>
                                </select>
                            </div>
                        </div>

                        <div class="col-lg-6" v-if="isStudentRole()">
                            <div class="mb-3">
                                <label class="form-label">Öğrenci No</label>
                                <input class="form-control lg-input"
                                       v-model="form.ogrenciNo"
                                       placeholder="Öğrenci numarası" />
                            </div>
                        </div>
                    </div>

                    <button class="btn btn-lymph w-100"
                            type="button"
                            @@click="saveUser">
                        <i class="fa fa-check-circle me-1"></i>
                        {{ form.id ? 'Kullanıcıyı Güncelle' : 'Kullanıcı Oluştur' }}
                    </button>

                    <button v-if="form.id"
                            class="btn btn-light w-100 rounded-pill mt-2"
                            type="button"
                            @@click="clearForm">
                        Vazgeç
                    </button>
                </div>
            </div>
        </div>

        <div class="col-xl-12">
            <div class="lg-card">
                <div class="lg-card-header">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <h5 class="section-title">
                                <i class="fa fa-users me-2 text-info"></i>
                                Kullanıcı Listesi
                            </h5>
                            <p class="section-desc">
                                Kullanıcıları filtreleyin, düzenleyin veya şifrelerini sıfırlayın.
                            </p>
                        </div>

                        <div class="d-flex gap-2">
                            <button class="filter-chip"
                                    type="button"
                                    :class="{ active: filters.roleId === '' }"
                                    @@click="filters.roleId = ''">
                                Tümü
                            </button>

                            <button class="filter-chip"
                                    type="button"
                                    v-for="role in roles"
                                    :key="role.id"
                                    :class="{ active: filters.roleId == role.id }"
                                    @@click="filters.roleId = role.id">
                                {{ role.name }}
                            </button>
                        </div>
                    </div>
                </div>

                <div class="lg-card-body">
                    <div class="mb-3">
                        <input class="form-control lg-input"
                               v-model="filters.search"
                               placeholder="Ad, soyad, telefon, öğrenci no veya role göre ara..." />
                    </div>

                    <div class="table-responsive">
                        <table class="table lg-table">
                            <thead>
                                <tr>
                                    <th>Kullanıcı</th>
                                    <th>Rol</th>
                                    <th>Öğrenci No</th>
                                    <th>Doğum Tarihi</th>
                                    <th>Simülasyon</th>
                                    <th>Çözümleme</th>
                                    <th>Toplam Puan</th>
                                    <th class="text-end">İşlemler</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr v-for="user in filteredUsers" :key="user.id">
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="user-avatar">
                                                {{ getInitials((user.name || '') + ' ' + (user.surname || '')) }}
                                            </div>

                                            <div>
                                                <div class="fw-bold text-dark">
                                                    {{ user.name || '-' }} {{ user.surname || '' }}
                                                </div>

                                                <small class="text-muted">
                                                    {{ formatDisplayPhone(user.phone) }}
                                                </small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="role-badge">
                                            {{ getRoleName(user) }}
                                        </span>
                                    </td>

                                    <td>
                                        <span v-if="isAdmin(user)" class="text-muted">—</span>
                                        <span v-else>{{ user.ogrenciNo || '-' }}</span>
                                    </td>


                                    <td>
                                        <span v-if="isAdmin(user)" class="text-muted">—</span>
                                        <span v-else :class="user.simulasyonTamamlandiMi ? 'status-ok' : 'status-no'">
                                            {{ user.simulasyonTamamlandiMi ? 'Tamamlandı' : 'Bekliyor' }}
                                        </span>
                                    </td>

                                    <td>
                                        <span v-if="isAdmin(user)" class="text-muted">—</span>
                                        <span v-else :class="user.cozumlemeTamamlandiMi ? 'status-ok' : 'status-no'">
                                            {{ user.cozumlemeTamamlandiMi ? 'Tamamlandı' : 'Bekliyor' }}
                                        </span>
                                    </td>

                                    <td>
                                        <span v-if="isAdmin(user)" class="text-muted">—</span>
                                        <span v-else class="role-badge">
                                            {{ user.toplamPuan || 0 }} Puan
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <div class="user-action-buttons">
                                            <div class="action-row mt-2">

                                                <button class="btn btn-sm btn-light rounded-pill"
                                                        type="button"
                                                        @@click="editUser(user)">
                                                    <i class="fa fa-pen me-1"></i>
                                                    Düzenle
                                                </button>

                                                <button class="btn btn-sm btn-warning text-white rounded-pill"
                                                        type="button"
                                                        @@click="openPasswordModal(user)">
                                                    <i class="fa fa-key me-1"></i>
                                                    Şifre
                                                </button>

                                                <button class="btn btn-sm btn-danger rounded-pill"
                                                        type="button"
                                                        @@click="deleteUser(user.id)">
                                                    <i class="fa fa-trash me-1"></i>
                                                    Sil
                                                </button>

                                            </div>
                                        </div>
                                    </td>
                                </tr>

                                <tr v-if="filteredUsers.length === 0">
                                    <td colspan="8" class="text-center text-muted py-5">
                                        Kullanıcı kaydı bulunamadı.
                                    </td>
                                </tr>
                            </tbody>

                        </table>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/page-js/user/kullanici_islemleri.js"></script>
}