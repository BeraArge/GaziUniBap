@{
    ViewData["Title"] = "Kullanıcı İşlemleri";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --lg-primary: #C2410C;
        --lg-secondary: #FB923C;
        --lg-soft: #FFF3E8;
        --lg-dark: #2D2A28;
        --lg-muted: #7A6D67;
    }

    .lymph-page {
        min-height: calc(100vh - 140px);
    }

    .lymph-hero {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        padding: 32px;
        margin-bottom: 28px;
        background: linear-gradient(135deg, #C2410C 0%, #EA580C 48%, #FB923C 100%);
        color: #fff;
        box-shadow: 0 18px 45px rgba(194, 65, 12, .24);
    }

        .lymph-hero::after {
            content: "";
            position: absolute;
            right: -70px;
            top: -80px;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .16);
        }

    .hero-title {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .hero-subtitle {
        opacity: .92;
        max-width: 620px;
        margin-bottom: 0;
    }

    .hero-logo-mark {
        width: 86px;
        height: 86px;
        border-radius: 24px;
        background: rgba(255, 255, 255, .95);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 14px 30px rgba(194, 65, 12, .14);
    }

        .hero-logo-mark img {
            width: 68px;
            height: 68px;
            object-fit: contain;
        }

    .lg-card {
        border: 0;
        border-radius: 26px;
        background: rgba(255, 255, 255, .92);
        box-shadow: 0 16px 36px rgba(194, 65, 12, .08);
    }

    .lg-card-header {
        padding: 24px 26px 0;
    }

    .lg-card-body {
        padding: 24px 26px 26px;
    }

    .section-title {
        color: var(--lg-dark);
        font-weight: 700;
        margin-bottom: 4px;
    }

    .section-desc {
        color: var(--lg-muted);
        font-size: 14px;
        margin-bottom: 0;
    }

    .lg-input,
    .lg-select {
        border-radius: 16px;
        border: 1px solid #F1D5C3;
        padding: 12px 15px;
        background-color: #FFFCFA;
    }

        .lg-input:focus,
        .lg-select:focus {
            border-color: var(--lg-primary);
            box-shadow: 0 0 0 .18rem rgba(194, 65, 12, .14);
        }

    .btn-lymph {
        border: 0;
        border-radius: 999px;
        padding: 11px 24px;
        color: #fff;
        font-weight: 600;
        background: linear-gradient(135deg, #C2410C, #FB923C);
        box-shadow: 0 12px 26px rgba(194, 65, 12, .22);
    }

        .btn-lymph:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 16px 30px rgba(194, 65, 12, .28);
        }

    .filter-chip {
        border: 1px solid #F1D5C3;
        background: #fff;
        border-radius: 999px;
        padding: 9px 16px;
        color: #7A6D67;
        font-weight: 500;
    }

        .filter-chip.active {
            color: #fff;
            border-color: transparent;
            background: linear-gradient(135deg, #C2410C, #FB923C);
        }

    .lg-table {
        border-collapse: separate;
        border-spacing: 0 12px;
    }

        .lg-table thead th {
            border: 0;
            color: #7A6D67;
            font-size: 13px;
            font-weight: 700;
            padding: 0 18px 8px;
            white-space: nowrap;
        }

        .lg-table tbody tr {
            background: #fff;
            box-shadow: 0 10px 22px rgba(194, 65, 12, .06);
        }

        .lg-table tbody td {
            border: 0;
            padding: 18px;
            vertical-align: middle;
        }

            .lg-table tbody td:first-child {
                border-top-left-radius: 18px;
                border-bottom-left-radius: 18px;
            }

            .lg-table tbody td:last-child {
                border-top-right-radius: 18px;
                border-bottom-right-radius: 18px;
            }

    .user-avatar {
        width: 44px;
        height: 44px;
        min-width: 44px;
        border-radius: 15px;
        background: linear-gradient(135deg, rgba(194,65,12,.12), rgba(251,146,60,.18));
        color: #C2410C;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .role-badge {
        border-radius: 999px;
        padding: 8px 13px;
        background: var(--lg-soft);
        color: var(--lg-primary);
        font-weight: 700;
        font-size: 13px;
        white-space: nowrap;
    }

    .status-ok {
        color: #B45309;
        background: #FEF3C7;
        border-radius: 999px;
        padding: 7px 12px;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-no {
        color: #cf3d3d;
        background: #fff0f0;
        border-radius: 999px;
        padding: 7px 12px;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

    .lg-alert {
        display: flex;
        align-items: center;
        background: linear-gradient(135deg, rgba(194,65,12,.08), rgba(251,146,60,.12));
        border: 1px solid rgba(194,65,12,.18);
        color: #A54813;
        border-radius: 16px;
        padding: 12px 14px;
        font-size: 14px;
        font-weight: 500;
    }

    .btn-sm {
        font-size: 12px;
        padding: 6px 12px;
    }

    .btn i {
        font-size: 12px;
    }

    .user-action-buttons {
        display: flex !important;
        flex-direction: column !important;
        align-items: flex-end !important;
    }

    .action-row {
        display: flex !important;
        gap: 8px !important;
        justify-content: flex-end !important;
        flex-wrap: nowrap !important;
    }

        .action-row .btn,
        .action-row a.btn {
            min-width: 115px !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

    .pagination-wrap {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 18px;
    }

    .page-btn {
        min-width: 40px;
        height: 40px;
        border: 1px solid #F1D5C3;
        border-radius: 14px;
        background: #fff;
        color: #C2410C;
        font-weight: 700;
    }

        .page-btn.active {
            color: #fff;
            border-color: transparent;
            background: linear-gradient(135deg, #C2410C, #FB923C);
            box-shadow: 0 10px 20px rgba(194,65,12,.20);
        }

        .page-btn:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

    @@media(max-width: 768px) {
        .lymph-page {
            padding: 24px 16px;
        }

        .lymph-hero {
            padding: 24px;
        }

        .hero-title {
            font-size: 24px;
        }

        .action-row {
            flex-wrap: wrap !important;
        }
    }
</style>
<div id="app" class="lymph-page mb-5 mt-1">

    <div class="lymph-hero">
        <div class="d-flex justify-content-between align-items-center position-relative">
            <div>
                <h1 class="hero-title">Kullanıcı İşlemleri</h1>
                <p class="hero-subtitle">
                    Admin ve öğrenci hesaplarını buradan yönetebilir, temel bilgileri düzenleyebilir
                    ve şifre sıfırlama işlemlerini hızlıca yapabilirsiniz.
                </p>
            </div>

            <div class="hero-logo-mark d-none d-md-flex">
                <img src="~/logo/gazi_logo.png" alt="gazi" height="150" />
            </div>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-xl-12">
            <div class="lg-card h-100">
                <div class="lg-card-header">
                    <h5 class="section-title">
                        <i class="fa fa-user-plus me-2 text-success"></i>
                        {{ form.id ? 'Kullanıcı Güncelle' : 'Yeni Kullanıcı' }}
                    </h5>
                    <p class="section-desc">
                        Admin veya öğrenci rolüyle kullanıcı oluşturun. Öğrenciye özel alanlar rol seçimine göre açılır.
                    </p>
                </div>

                <div class="lg-card-body">

                    <div class="lg-alert mb-3">
                        <i class="fa fa-info-circle me-2"></i>
                        Kullanıcı şifresi otomatik olarak <strong class="mx-1">123123Aa</strong> oluşturulur.
                        Simülasyon, çözümleme ve toplam puan bilgileri bu ekrandan güncellenemez.
                    </div>

                    <div class="row">
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label">Rol</label>

                                <select class="form-select lg-select"
                                        v-model="form.roleId"
                                        :disabled="form.id">
                                    <option value="">Rol seçiniz</option>
                                    <option v-for="role in roles"
                                            :key="role.id"
                                            :value="role.id">
                                        {{ role.name }}
                                    </option>
                                </select>

                                <small v-if="form.id" class="text-muted">
                                    Kullanıcı güncellenirken rol değiştirilemez.
                                </small>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label">Ad</label>
                                <input class="form-control lg-input"
                                       v-model="form.name"
                                       placeholder="Ad" />
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label">Soyad</label>
                                <input class="form-control lg-input"
                                       v-model="form.surname"
                                       placeholder="Soyad" />
                            </div>
                        </div>

                        <div class="col-lg-6" v-if="isStudentRole()">
                            <div class="mb-3">
                                <label class="form-label">Kullanıcı Adı</label>
                                <input class="form-control lg-input"
                                       v-model="form.username"
                                       placeholder="Kullanıcı adı" />
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label">Telefon Numarası</label>
                                @* <input class="form-control lg-input"
                                       v-model="form.phone"
                                       @@input="formatPhone"
                                       placeholder="5XXXXXXXXX" /> *@
                                <input type="tel"
                                       class="form-control lg-input"
                                       v-model="form.phone"
                                       @@input="formatPhone"
                                       maxlength="11"
                                       placeholder="05555555555">
                            </div>
                        </div>

                        <div class="col-lg-6" v-if="isStudentRole()">
                            <div class="mb-3">
                                <label class="form-label">Öğrenci No</label>
                                <input class="form-control lg-input"
                                       v-model="form.ogrenciNo"
                                       placeholder="Öğrenci numarası" />
                            </div>
                        </div>
                    </div>

                    <button class="btn btn-lymph w-100"
                            type="button"
                            @@click="saveUser">
                        <i class="fa fa-check-circle me-1"></i>
                        {{ form.id ? 'Kullanıcıyı Güncelle' : 'Kullanıcı Oluştur' }}
                    </button>

                    <button v-if="form.id"
                            class="btn btn-light w-100 rounded-pill mt-2"
                            type="button"
                            @@click="clearForm">
                        Vazgeç
                    </button>
                </div>
            </div>
        </div>

        <div class="col-xl-12">
            <div class="lg-card">
                <div class="lg-card-header">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <h5 class="section-title">
                                <i class="fa fa-users me-2 text-info"></i>
                                Kullanıcı Listesi
                            </h5>
                            <p class="section-desc">
                                Kullanıcıları filtreleyin, düzenleyin veya şifrelerini sıfırlayın.
                            </p>
                        </div>

                        <div class="d-flex gap-2">
                            <button class="filter-chip"
                                    type="button"
                                    :class="{ active: filters.roleId === '' }"
                                    @@click="filters.roleId = ''; applyFilters()">
                                Tümü
                            </button>

                            <button class="filter-chip"
                                    type="button"
                                    v-for="role in roles"
                                    :key="role.id"
                                    :class="{ active: filters.roleId == role.id }"
                                    @@click="filters.roleId = role.id; applyFilters()">
                                {{ role.name }}
                            </button>
                        </div>
                    </div>
                </div>

                <div class="lg-card-body">
                    <div class="mb-3">
                        <input class="form-control lg-input"
                               v-model="filters.search"
                               @@input="applyFilters"
                               placeholder="Ad, soyad, kullanıcı adı, telefon, öğrenci no veya role göre ara..." />
                    </div>

                    <div class="table-responsive">
                        <table class="table lg-table">
                            <thead>
                                <tr>
                                    <th>Kullanıcı</th>
                                    <th>Rol</th>
                                    <th>Öğrenci No</th>
                                    <th>Simülasyon</th>
                                    <th>Çözümleme</th>
                                    <th>Toplam Puan</th>
                                    <th class="text-end">İşlemler</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr v-for="user in filteredUsers" :key="user.id">
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="user-avatar">
                                                {{ getInitials((user.name || '') + ' ' + (user.surname || '')) }}
                                            </div>

                                            <div>
                                                <div class="fw-bold text-dark">
                                                    {{ user.name || '-' }} {{ user.surname || '' }}
                                                </div>

                                                <small class="text-muted d-block">
                                                    @@{{ user.userName || '-' }}
                                                </small>

                                                <small class="text-muted">
                                                    {{ formatDisplayPhone(user.phone) }}
                                                </small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="role-badge">
                                            {{ getRoleName(user) }}
                                        </span>
                                    </td>

                                    <td>
                                        <span v-if="isAdmin(user)" class="text-muted">—</span>
                                        <span v-else>{{ user.ogrenciNo || '-' }}</span>
                                    </td>

                                    <td>
                                        <span v-if="isAdmin(user)" class="text-muted">—</span>
                                        <span v-else :class="user.simulasyonTamamlandiMi ? 'status-ok' : 'status-no'">
                                            {{ user.simulasyonTamamlandiMi ? 'Tamamlandı' : 'Bekliyor' }}
                                        </span>
                                    </td>

                                    <td>
                                        <span v-if="isAdmin(user)" class="text-muted">—</span>
                                        <span v-else :class="user.cozumlemeTamamlandiMi ? 'status-ok' : 'status-no'">
                                            {{ user.cozumlemeTamamlandiMi ? 'Tamamlandı' : 'Bekliyor' }}
                                        </span>
                                    </td>

                                    <td>
                                        <span v-if="isAdmin(user)" class="text-muted">—</span>
                                        <span v-else class="role-badge">
                                            {{ user.toplamPuan || 0 }} Puan
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <div class="user-action-buttons">
                                            <div class="action-row mt-2">

                                                <button class="btn btn-sm btn-light rounded-pill"
                                                        type="button"
                                                        @@click="editUser(user)">
                                                    <i class="fa fa-pen me-1"></i>
                                                    Düzenle
                                                </button>

                                                <button class="btn btn-sm btn-warning text-white rounded-pill"
                                                        type="button"
                                                        @@click="openPasswordModal(user)">
                                                    <i class="fa fa-key me-1"></i>
                                                    Şifre
                                                </button>

                                                <button class="btn btn-sm btn-danger rounded-pill"
                                                        type="button"
                                                        @@click="deleteUser(user.id)">
                                                    <i class="fa fa-trash me-1"></i>
                                                    Sil
                                                </button>

                                            </div>
                                        </div>
                                    </td>
                                </tr>

                                <tr v-if="filteredUsers.length === 0">
                                    <td colspan="7" class="text-center text-muted py-5">
                                        Kullanıcı kaydı bulunamadı.
                                    </td>
                                </tr>
                            </tbody>

                        </table>
                    </div>

                    <div class="pagination-wrap">
                        <div class="text-muted small">
                            Toplam {{ pagination.count }} kayıt
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <button class="page-btn"
                                    type="button"
                                    :disabled="pagination.page === 0"
                                    @@click="changePage(pagination.page - 1)">
                                <i class="fa fa-chevron-left"></i>
                            </button>

                            <button v-for="page in pagination.pages"
                                    :key="page"
                                    type="button"
                                    class="page-btn"
                                    :class="{ active: pagination.page === page - 1 }"
                                    @@click="changePage(page - 1)">
                                {{ page }}
                            </button>

                            <button class="page-btn"
                                    type="button"
                                    :disabled="pagination.page >= pagination.pages - 1"
                                    @@click="changePage(pagination.page + 1)">
                                <i class="fa fa-chevron-right"></i>
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/page-js/user/kullanici_islemleri.js"></script>
}