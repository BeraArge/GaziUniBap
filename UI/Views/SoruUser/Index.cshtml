@{
    ViewData["Title"] = "Cevap Raporları";
}

<style>
    :root {
        --rp-primary: #C2410C;
        --rp-primary-dark: #9A3412;
        --rp-secondary: #FB923C;
        --rp-accent: #FDBA74;
        --rp-dark: #2D2A28;
        --rp-muted: #7A6D67;
        --rp-border: #F2DDD0;
    }

    .report-page {
        min-height: calc(100vh - 90px);
        padding: 34px;
        border-radius: 32px;
        background: radial-gradient(circle at top left, rgba(251,146,60,.18), transparent 36%), radial-gradient(circle at top right, rgba(194,65,12,.14), transparent 32%), linear-gradient(135deg, #FFF9F4 0%, #FFF3E8 45%, #FFFFFF 100%);
    }

    .report-hero {
        padding: 30px 34px;
        margin-bottom: 26px;
        border-radius: 30px;
        color: #fff;
        background: linear-gradient(135deg, #C2410C 0%, #EA580C 42%, #FB923C 100%);
        box-shadow: 0 24px 55px rgba(194,65,12,.28);
    }

    .hero-kicker {
        display: inline-flex;
        gap: 8px;
        align-items: center;
        padding: 8px 14px;
        margin-bottom: 14px;
        border-radius: 999px;
        background: rgba(255,255,255,.18);
        font-weight: 800;
        font-size: 13px;
    }

    .hero-title {
        font-size: 34px;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .hero-subtitle {
        max-width: 760px;
        margin: 0;
        opacity: .94;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-card,
    .report-card {
        border: 1px solid rgba(255,255,255,.72);
        border-radius: 26px;
        background: rgba(255,255,255,.82);
        box-shadow: 0 18px 42px rgba(194,65,12,.10);
        backdrop-filter: blur(16px);
    }

    .stat-card {
        padding: 22px;
    }

    .stat-icon {
        width: 46px;
        height: 46px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(135deg, var(--rp-primary), var(--rp-secondary));
        margin-bottom: 14px;
        box-shadow: 0 12px 24px rgba(194,65,12,.20);
    }

    .stat-label {
        color: var(--rp-muted);
        font-size: 13px;
        font-weight: 800;
    }

    .stat-value {
        color: var(--rp-dark);
        font-size: 28px;
        font-weight: 900;
    }

    .report-card {
        overflow: hidden;
    }

    .report-header {
        padding: 24px 26px;
        border-bottom: 1px solid rgba(242,221,208,.80);
        background: linear-gradient(180deg, rgba(255,255,255,.90), rgba(255,247,240,.60));
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--rp-dark);
        font-weight: 900;
        margin-bottom: 6px;
    }

        .section-title i {
            width: 36px;
            height: 36px;
            border-radius: 14px;
            color: #fff;
            background: linear-gradient(135deg, var(--rp-primary), var(--rp-secondary));
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 22px rgba(194,65,12,.22);
        }

    .section-desc {
        color: var(--rp-muted);
        margin: 0;
        font-size: 14px;
    }

    .report-body {
        padding: 24px 26px 28px;
    }

    .search-wrap {
        position: relative;
        margin-bottom: 22px;
    }

        .search-wrap i {
            position: absolute;
            top: 50%;
            left: 16px;
            transform: translateY(-50%);
            color: var(--rp-muted);
        }

    .search-input {
        width: 100%;
        min-height: 50px;
        border-radius: 16px;
        border: 1px solid var(--rp-border);
        padding: 12px 16px 12px 44px;
        background: rgba(255,255,255,.94);
        color: var(--rp-dark);
    }

        .search-input:focus {
            border-color: var(--rp-primary);
            box-shadow: 0 0 0 .20rem rgba(194,65,12,.15);
            outline: 0;
        }

    .user-grid {
        align-items: start;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .user-card {
        align-self: start;
        border: 1px solid rgba(194,65,12,.12);
        border-radius: 24px;
        background: rgba(255,255,255,.88);
        box-shadow: 0 12px 26px rgba(194,65,12,.07);
        overflow: hidden;
    }

    .answer-detail-scroll {
        max-height: 500px;
        overflow-y: auto;
        overflow-x: hidden;
        padding-right: 6px;
    }

        .answer-detail-scroll::-webkit-scrollbar {
            width: 8px;
        }

        .answer-detail-scroll::-webkit-scrollbar-track {
            background: #FFF1E7;
            border-radius: 999px;
        }

        .answer-detail-scroll::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, var(--rp-primary), var(--rp-secondary));
            border-radius: 999px;
        }

    .user-card-top {
        padding: 20px;
        display: flex;
        gap: 14px;
        align-items: center;
    }

    .avatar {
        width: 54px;
        height: 54px;
        min-width: 54px;
        border-radius: 18px;
        color: #fff;
        background: linear-gradient(135deg, var(--rp-primary), var(--rp-secondary));
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: 20px;
        box-shadow: 0 12px 24px rgba(194,65,12,.20);
    }

    .user-name {
        color: var(--rp-dark);
        font-size: 18px;
        font-weight: 900;
    }

    .user-sub {
        color: var(--rp-muted);
        font-size: 13px;
    }

    .score-row {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        padding: 0 20px 20px;
    }

    .mini-score {
        border-radius: 18px;
        background: rgba(194,65,12,.07);
        padding: 12px;
        border: 1px solid rgba(194,65,12,.08);
    }

        .mini-score strong {
            display: block;
            color: var(--rp-dark);
            font-size: 18px;
            font-weight: 900;
        }

        .mini-score span {
            color: var(--rp-muted);
            font-size: 12px;
            font-weight: 800;
        }

    .progress-wrap {
        padding: 0 20px 20px;
    }

    .progress {
        height: 10px;
        border-radius: 999px;
        background: #FFE7D3;
    }

    .progress-bar {
        border-radius: 999px;
        background: linear-gradient(135deg, var(--rp-primary), var(--rp-secondary));
    }

    .detail-toggle {
        width: 100%;
        border: 0;
        padding: 15px 20px;
        background: rgba(194,65,12,.07);
        color: var(--rp-primary);
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .detail-toggle.secondary {
            background: rgba(251,146,60,.12);
            color: var(--rp-primary-dark);
            border-top: 1px solid rgba(194,65,12,.10);
        }

    .answer-detail {
        padding: 18px 20px 20px;
        border-top: 1px solid rgba(194,65,12,.10);
        background: rgba(255,247,240,.55);
    }

    .answer-item {
        padding: 14px;
        border-radius: 18px;
        background: #fff;
        border: 1px solid rgba(242,221,208,.95);
        margin-bottom: 10px;
        box-shadow: 0 8px 18px rgba(194,65,12,.04);
    }

    .answer-question {
        color: var(--rp-dark);
        font-weight: 900;
        margin-bottom: 10px;
        line-height: 1.45;
    }

    .answer-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 11px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 900;
        background: rgba(194,65,12,.09);
        color: var(--rp-primary);
    }

        .pill.success {
            background: rgba(251,146,60,.18);
            color: var(--rp-primary-dark);
        }

        .pill.danger {
            background: rgba(220,53,69,.10);
            color: #c92a3a;
        }

        .pill.neutral {
            background: rgba(122,109,103,.12);
            color: var(--rp-muted);
        }

    .empty-state {
        text-align: center;
        color: var(--rp-muted);
        padding: 50px 0;
        font-weight: 800;
    }

    .pagination-wrap {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 22px;
    }

    .page-btn {
        min-width: 40px;
        height: 40px;
        border: 1px solid rgba(194,65,12,.18);
        border-radius: 14px;
        background: #fff;
        color: var(--rp-primary);
        font-weight: 900;
    }

        .page-btn.active {
            color: #fff;
            background: linear-gradient(135deg, var(--rp-primary), var(--rp-secondary));
            box-shadow: 0 12px 24px rgba(194,65,12,.22);
        }

        .page-btn:disabled {
            opacity: .4;
        }

    .btn-success {
        border: 0 !important;
        background: linear-gradient(135deg, var(--rp-primary), var(--rp-secondary)) !important;
        box-shadow: 0 12px 24px rgba(194,65,12,.20);
        font-weight: 800;
    }

        .btn-success:hover {
            transform: translateY(-1px);
            box-shadow: 0 16px 28px rgba(194,65,12,.26);
        }

    @@media(max-width: 1200px) {
        .stats-grid,
        .user-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media(max-width: 768px) {
        .report-page {
            padding: 18px;
        }

        .stats-grid,
        .user-grid,
        .score-row {
            grid-template-columns: 1fr;
        }

        .hero-title {
            font-size: 26px;
        }
    }
</style>
<div id="app" class="report-page">

    <div class="report-hero">
        <div class="hero-kicker">
            <i class="fa fa-chart-line"></i>
            Cevap Analizi
        </div>

        <h1 class="hero-title">Kullanıcı Cevap Raporları</h1>

        <p class="hero-subtitle">
            Mobil uygulamadan verilen cevapları kullanıcı bazlı inceleyin, başarı oranlarını ve puan dağılımlarını görüntüleyin.
        </p>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon"><i class="fa fa-users"></i></div>
            <div class="stat-label">Toplam Kullanıcı</div>
            <div class="stat-value">{{ summary.totalUsers }}</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon"><i class="fa fa-list-check"></i></div>
            <div class="stat-label">Toplam Cevap</div>
            <div class="stat-value">{{ summary.totalAnswers }}</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon"><i class="fa fa-star"></i></div>
            <div class="stat-label">Ortalama Puan</div>
            <div class="stat-value">{{ summary.averageScore }} / 10</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon"><i class="fa fa-percent"></i></div>
            <div class="stat-label">Ortalama Başarı</div>
            <div class="stat-value">%{{ summary.averageSuccess }}</div>
        </div>
    </div>

    <div class="report-card">
        <div class="report-header">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h5 class="section-title">
                        <i class="fa fa-user-graduate"></i>
                        Kullanıcılar
                    </h5>
                    <p class="section-desc">
                        Her kullanıcı için cevap sayısı, doğru/yanlış dağılımı, ortalama puan ve detaylar.
                    </p>
                </div>

                <button class="btn btn-success rounded-pill"
                        type="button"
                        @@click="downloadExcel"
                        :disabled="isExcelDownloading">
                    <span v-if="isExcelDownloading"
                          class="spinner-border spinner-border-sm me-2"></span>
                    <i v-else class="fa fa-file-excel me-1"></i>
                    {{ isExcelDownloading ? 'Hazırlanıyor...' : 'Excel İndir' }}
                </button>
            </div>
        </div>

        <div class="report-body">

            <div class="search-wrap">
                <i class="fa fa-search"></i>
                <input class="search-input"
                       v-model="search"
                       placeholder="Kullanıcı adına göre ara..." />
            </div>

            <div class="user-grid" v-if="pagedReports.length > 0">
                <div class="user-card" v-for="user in pagedReports" :key="user.userId">

                    <div class="user-card-top">
                        <div class="avatar">
                            {{ getInitials(user.userName) }}
                        </div>

                        <div>
                            <div class="user-name">{{ user.userName || '-' }}</div>

                            <div class="user-sub">
                                <strong>Kullanıcı Adı:</strong> {{ user.userName || '-' }}
                            </div>

                            <div class="user-sub">
                                <strong>Öğrenci No:</strong> {{ user.ogrenciNo || '-' }}
                            </div>

                            <div class="user-sub">
                                <strong>Telefon:</strong> {{ user.phone || '-' }}
                            </div>

                            <div class="user-sub">
                                <strong>Kullanıcı ID:</strong> {{ user.userId }}
                            </div>
                        </div>
                    </div>

                    <div class="score-row">
                        <div class="mini-score">
                            <strong>{{ user.totalQuestion }}</strong>
                            <span>Cevap</span>
                        </div>

                        <div class="mini-score">
                            <strong>{{ user.correctCount }}</strong>
                            <span>Doğru</span>
                        </div>

                        <div class="mini-score">
                            <strong>{{ user.wrongCount }}</strong>
                            <span>Yanlış</span>
                        </div>

                        <div class="mini-score">
                            <strong>{{ user.totalScore }}</strong>
                            <span>Puan</span>
                        </div>
                    </div>

                    <div class="progress-wrap">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small fw-bold">Başarı Oranı</span>
                            <span class="text-muted small fw-bold">%{{ user.successRate }}</span>
                        </div>

                        <div class="progress">
                            <div class="progress-bar"
                                 role="progressbar"
                                 :style="{ width: user.successRate + '%' }">
                            </div>
                        </div>
                    </div>

                    <button class="detail-toggle"
                            type="button"
                            @@click="toggleDetail(user.userId)">
                        <span>
                            <i class="fa fa-list-check me-1"></i>
                            Cevap Detayları
                        </span>
                        <i class="fa"
                           :class="openedUserId === user.userId ? 'fa-chevron-up' : 'fa-chevron-down'"></i>
                    </button>

                    <div class="answer-detail" v-show="openedUserId === user.userId">
                        <div class="answer-detail-scroll">

                            <div class="answer-item" v-for="answer in user.answers" :key="answer.soruId">
                                <div class="answer-question">
                                    {{ answer.soruMetni || '-' }}
                                </div>

                                <div class="answer-meta">
                                    <span class="pill">
                                        Verilen: {{ answer.verilenCevap || '-' }}
                                    </span>

                                    <span class="pill success">
                                        Doğru: {{ answer.dogruCevap || '-' }}
                                    </span>

                                    <span class="pill"
                                          :class="answer.puan === 10 ? 'success' : 'danger'">
                                        Puan: {{ answer.puan || 0 }}
                                    </span>
                                    <span class="pill neutral">
                                        Cevaplama Süresi: {{ answer.cevaplamaSuresiSaniye || 0 }} sn
                                    </span>

                                    <span class="pill neutral">
                                        Açıklama Okuma: {{ answer.aciklamaOkumaSuresiSaniye || 0 }} sn
                                    </span>
                                </div>
                            </div>

                            <div v-if="!user.answers || user.answers.length === 0"
                                 class="text-muted small">
                                Cevap detayı bulunamadı.
                            </div>
                        </div>
                    </div>

                    <button class="detail-toggle secondary"
                            type="button"
                            @@click="toggleCozumleme(user.userId)">
                        <span>
                            <i class="fa fa-clipboard-question me-1"></i>
                            Çözümleme Cevapları
                        </span>
                        <i class="fa"
                           :class="openedCozumlemeUserId === user.userId ? 'fa-chevron-up' : 'fa-chevron-down'"></i>
                    </button>

                    <div class="answer-detail" v-show="openedCozumlemeUserId === user.userId">
                        <div class="answer-detail-scroll">
                            <template v-if="user.cozumlemeSorular && user.cozumlemeSorular.length > 0">
                                <div class="answer-item"
                                     v-for="cozumleme in user.cozumlemeSorular"
                                     :key="cozumleme.id">

                                    <div class="answer-question">
                                        {{ cozumleme.asama || 'Çözümleme Aşaması' }}
                                    </div>

                                    <div class="answer-item"
                                         v-for="(item, index) in cozumleme.soruCevap"
                                         :key="index">

                                        <div class="answer-question">
                                            {{ item.soru || item.Soru || item.question || item.Question || 'Soru' }}
                                        </div>

                                        <div class="answer-meta">
                                            <span class="pill">
                                                Cevap: {{ item.cevap || item.Cevap || item.answer || item.Answer || '-' }}
                                            </span>

                                            <span class="pill neutral">
                                                Aşama: {{ cozumleme.asama || '-' }}
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </template>

                            <div v-else class="text-muted small">
                                Çözümleme cevabı bulunamadı.
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div v-else class="empty-state">
                <i class="fa fa-circle-info me-1"></i>
                Kayıt bulunamadı.
            </div>

            <div class="pagination-wrap" >
                <button class="page-btn"
                        type="button"
                        @@click="changePage(currentPage - 1)"
                        :disabled="currentPage === 1">
                    <i class="fa fa-chevron-left"></i>
                </button>

                <button v-for="page in totalPages"
                        :key="page"
                        type="button"
                        class="page-btn"
                        :class="{ active: currentPage === page }"
                        @@click="changePage(page)">
                    {{ page }}
                </button>

                <button class="page-btn"
                        type="button"
                        @@click="changePage(currentPage + 1)"
                        :disabled="currentPage === totalPages">
                    <i class="fa fa-chevron-right"></i>
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/page-js/soruUser/index.js"></script>
}