@{
    ViewData["Title"] = "Sorular";
}

<style>
    :root {
        --lg-primary: #087c8f;
        --lg-primary-dark: #056273;
        --lg-secondary: #6fbd63;
        --lg-bg: #f4fbf8;
        --lg-dark: #243044;
        --lg-muted: #7d8797;
        --lg-border: #e5edf1;
    }

    .question-page {
        position: relative;
        min-height: calc(100vh - 90px);
        padding: 34px;
        overflow: hidden;
        background: radial-gradient(circle at top left, rgba(111,189,99,.28), transparent 34%), radial-gradient(circle at top right, rgba(8,124,143,.20), transparent 32%), linear-gradient(135deg, #f8fffc 0%, #eef8f6 42%, #f7fbff 100%);
        border-radius: 32px;
    }

        .question-page::before {
            content: "";
            position: absolute;
            inset: 18px;
            border: 1px solid rgba(8,124,143,.10);
            border-radius: 28px;
            pointer-events: none;
        }

    .question-shell {
        position: relative;
        z-index: 1;
    }

    .question-hero {
        position: relative;
        z-index: 1;
        padding: 30px 34px;
        margin-bottom: 28px;
        border-radius: 30px;
        background: linear-gradient(135deg, #087c8f 0%, #159d98 48%, #6fbd63 100%);
        color: #fff;
        box-shadow: 0 22px 55px rgba(8,124,143,.24);
        overflow: hidden;
    }

        .question-hero::after {
            content: "";
            position: absolute;
            width: 330px;
            height: 330px;
            right: -120px;
            top: -150px;
            border-radius: 50%;
            background: rgba(255,255,255,.18);
        }

        .question-hero::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: 130px;
            bottom: -100px;
            border-radius: 50%;
            background: rgba(255,255,255,.12);
        }

    .hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        margin-bottom: 14px;
        border-radius: 999px;
        background: rgba(255,255,255,.18);
        font-size: 13px;
        font-weight: 700;
    }

    .hero-title {
        position: relative;
        z-index: 1;
        font-size: 34px;
        font-weight: 800;
        margin-bottom: 8px;
        letter-spacing: -.5px;
    }

    .hero-subtitle {
        position: relative;
        z-index: 1;
        max-width: 760px;
        margin: 0;
        opacity: .94;
        font-size: 15px;
    }

    .glass-card {
        border: 1px solid rgba(255,255,255,.72);
        border-radius: 28px;
        background: rgba(255,255,255,.78);
        box-shadow: 0 20px 48px rgba(32, 52, 70, .10);
        backdrop-filter: blur(16px);
        overflow: hidden;
    }

    .glass-card-header {
        padding: 24px 26px 12px;
        border-bottom: 1px solid rgba(229,237,241,.75);
        background: linear-gradient(180deg, rgba(255,255,255,.85), rgba(255,255,255,.55));
    }

    .glass-card-body {
        padding: 24px 26px 28px;
    }

    .accordion-head {
        width: 100%;
        border: 0;
        padding: 24px 26px;
        background: linear-gradient(180deg, rgba(255,255,255,.92), rgba(255,255,255,.62));
        display: flex;
        justify-content: space-between;
        align-items: center;
        text-align: left;
    }

    .accordion-arrow {
        width: 42px;
        height: 42px;
        min-width: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        color: var(--lg-primary);
        background: rgba(8,124,143,.08);
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--lg-dark);
        font-weight: 800;
        margin-bottom: 6px;
    }

        .section-title i {
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            color: #fff;
            background: linear-gradient(135deg, var(--lg-primary), var(--lg-secondary));
            box-shadow: 0 10px 22px rgba(8,124,143,.22);
        }

    .section-desc {
        color: var(--lg-muted);
        font-size: 14px;
        margin: 0;
    }

    .form-label {
        color: #2c3749;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .lg-input {
        min-height: 48px;
        border-radius: 16px;
        border: 1px solid var(--lg-border);
        background: rgba(255,255,255,.92);
        padding: 12px 15px;
        color: var(--lg-dark);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
    }

    textarea.lg-input {
        resize: vertical;
        line-height: 1.55;
    }

    .lg-input:focus {
        border-color: var(--lg-primary);
        box-shadow: 0 0 0 .20rem rgba(8,124,143,.12);
    }

    .upload-zone {
        position: relative;
        border: 1.5px dashed rgba(8,124,143,.38);
        border-radius: 22px;
        padding: 22px;
        background: linear-gradient(135deg, rgba(8,124,143,.06), rgba(111,189,99,.10));
        transition: .2s ease;
    }

        .upload-zone:hover {
            transform: translateY(-1px);
            border-color: var(--lg-primary);
            box-shadow: 0 14px 30px rgba(8,124,143,.10);
        }

    .upload-icon {
        width: 48px;
        height: 48px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(135deg, var(--lg-primary), var(--lg-secondary));
        box-shadow: 0 12px 24px rgba(8,124,143,.22);
    }

    .answer-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }

    .answer-letter {
        width: 52px;
        height: 52px;
        min-width: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: linear-gradient(135deg, #087c8f, #6fbd63);
        color: white;
        font-size: 18px;
        font-weight: 800;
        box-shadow: 0 8px 20px rgba(8,124,143,.2);
    }

    .answer-input {
        height: 52px;
        border-radius: 16px;
    }

    .answer-add-row {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 12px;
        border: 1.5px dashed rgba(8,124,143,.35);
        border-radius: 18px;
        padding: 10px;
        background: rgba(255,255,255,.58);
        color: var(--lg-primary);
        font-weight: 800;
        transition: .2s ease;
    }

        .answer-add-row:hover {
            transform: translateY(-1px);
            border-color: var(--lg-primary);
            background: rgba(8,124,143,.06);
        }

    .answer-remove-btn {
        width: 44px;
        height: 44px;
        min-width: 44px;
        border: 0;
        border-radius: 14px;
        color: #fff;
        background: #dc3545;
    }

        .answer-remove-btn:disabled {
            opacity: .35;
            cursor: not-allowed;
        }

    .btn-lymph {
        border: 0;
        border-radius: 999px;
        padding: 13px 24px;
        color: #fff;
        font-weight: 800;
        background: linear-gradient(135deg, var(--lg-primary), var(--lg-secondary));
        box-shadow: 0 14px 28px rgba(8,124,143,.24);
        transition: .2s ease;
    }

        .btn-lymph:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 18px 34px rgba(8,124,143,.30);
        }

    .search-wrap {
        position: relative;
    }

        .search-wrap i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--lg-muted);
        }

        .search-wrap input {
            padding-left: 44px;
        }

    .question-table {
        border-collapse: separate;
        border-spacing: 0 12px;
    }

        .question-table thead th {
            border: 0;
            color: #7d8797;
            font-size: 12px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .4px;
            padding: 0 16px 8px;
            white-space: nowrap;
        }

        .question-table tbody tr {
            background: rgba(255,255,255,.86);
            box-shadow: 0 10px 24px rgba(32,52,70,.06);
        }

        .question-table tbody td {
            border: 0;
            padding: 18px 16px;
            vertical-align: middle;
        }

            .question-table tbody td:first-child {
                border-top-left-radius: 20px;
                border-bottom-left-radius: 20px;
            }

            .question-table tbody td:last-child {
                border-top-right-radius: 20px;
                border-bottom-right-radius: 20px;
            }

    .question-text {
        color: var(--lg-dark);
        font-weight: 800;
        max-width: 420px;
        white-space: normal;
    }

    .table-long-text {
        max-width: 340px;
        color: var(--lg-muted);
        white-space: normal;
    }

    .question-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(8,124,143,.08);
        color: var(--lg-primary);
        font-weight: 900;
        font-size: 13px;
    }

    .mini-muted {
        color: var(--lg-muted);
        font-size: 13px;
        margin-top: 5px;
    }

    .pagination-wrap {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 18px;
    }

    .page-btn {
        min-width: 40px;
        height: 40px;
        border: 1px solid rgba(8,124,143,.16);
        border-radius: 14px;
        background: #fff;
        color: var(--lg-primary);
        font-weight: 800;
    }

        .page-btn.active {
            color: #fff;
            background: linear-gradient(135deg, var(--lg-primary), var(--lg-secondary));
            box-shadow: 0 10px 20px rgba(8,124,143,.18);
        }

        .page-btn:disabled {
            opacity: .4;
            cursor: not-allowed;
        }

    @@media(max-width: 992px) {
        .question-page {
            padding: 18px;
            border-radius: 22px;
        }

        .question-hero {
            padding: 24px;
        }

        .hero-title {
            font-size: 26px;
        }

        .answer-row {
            align-items: stretch;
        }
    }

    .file-info-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 18px;
        background: rgba(255,255,255,.76);
        border: 1px solid rgba(8,124,143,.12);
    }

        .file-info-card.selected {
            background: rgba(111,189,99,.12);
            border-color: rgba(111,189,99,.28);
        }

    .file-info-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(135deg, #087c8f, #6fbd63);
    }

    .file-info-title {
        font-size: 12px;
        font-weight: 800;
        color: var(--lg-dark);
    }

    .file-info-text {
        font-size: 13px;
        color: var(--lg-muted);
        word-break: break-all;
    }

    .file-info-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 18px;
        background: rgba(255,255,255,.76);
        border: 1px solid rgba(8,124,143,.12);
    }

        .file-info-card.selected {
            background: rgba(111,189,99,.12);
            border-color: rgba(111,189,99,.28);
        }

    .file-info-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(135deg, #087c8f, #6fbd63);
    }

    .file-info-title {
        font-size: 12px;
        font-weight: 800;
        color: var(--lg-dark);
    }

    .file-info-text {
        font-size: 13px;
        color: var(--lg-muted);
        word-break: break-all;
    }
</style>

<div id="app" class="question-page mb-5 mt-1">
    @Html.AntiForgeryToken()

    <div class="question-hero">
        <div class="hero-kicker">
            <i class="fa fa-shield-heart"></i>
            Eğitim İçerik Yönetimi
        </div>

        <h1 class="hero-title">Soru Yönetimi</h1>

        <p class="hero-subtitle">
            Videoya bağlı soruları oluşturun, cevap şıklarını yönetin ve doğru cevap açıklamalarını tek ekrandan düzenleyin.
        </p>
    </div>

    <div class="question-shell">

        <div class="mb-4" id="questionFormArea">
            <div class="glass-card">

                <button class="accordion-head"
                        type="button"
                        @@click="formAccordionOpen = !formAccordionOpen">
                    <div>
                        <h5 class="section-title mb-1">
                            <i class="fa fa-circle-question"></i>
                            {{ isUpdate ? 'Soru Güncelle' : 'Yeni Soru Oluştur' }}
                        </h5>

                        <p class="section-desc">
                            Video, hedef, ölçek maddesi, soru metni ve cevap şıklarını giriniz.
                        </p>
                    </div>

                    <div class="accordion-arrow">
                        <i class="fa"
                           :class="formAccordionOpen ? 'fa-chevron-up' : 'fa-chevron-down'"></i>
                    </div>
                </button>

                <div v-show="formAccordionOpen" class="glass-card-body">
                    <div class="mb-4">
                        <label class="form-label">Video Dosyası</label>

                        <div class="upload-zone">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="upload-icon">
                                    <i class="fa fa-cloud-arrow-up"></i>
                                </div>

                                <div>
                                    <strong>{{ isUpdate ? 'Video güncelle' : 'Video yükleyin' }}</strong>
                                    <div class="text-muted small">
                                        MP4, MOV veya desteklenen video formatları
                                    </div>
                                </div>
                            </div>

                            <input class="form-control"
                                   type="file"
                                   accept="video/*"
                                   @@change="handleVideoFile" />

                            <div v-if="isUpdate && form.videoPath" class="file-info-card mt-3">
                                <div class="file-info-icon">
                                    <i class="fa fa-video"></i>
                                </div>

                                <div>
                                    <div class="file-info-title">Mevcut video</div>
                                    <div class="file-info-text">{{ getFileName(form.videoPath) }}</div>
                                </div>
                            </div>

                            <div v-if="form.videoFile" class="file-info-card selected mt-3">
                                <div class="file-info-icon">
                                    <i class="fa fa-file-video"></i>
                                </div>

                                <div>
                                    <div class="file-info-title">Yeni seçilen dosya</div>
                                    <div class="file-info-text">{{ form.videoFile.name }}</div>
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Video Transcript</label>
                            <textarea class="form-control lg-input"
                                      rows="6"
                                      v-model="form.videoTranscript"
                                      placeholder="Video bittikten sonra mobilde gösterilecek transcript metnini giriniz..."></textarea>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Hedef</label>
                        <textarea class="form-control lg-input"
                                  rows="3"
                                  v-model="form.hedef"
                                  placeholder="Hedef metnini giriniz..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Ölçek Maddesi</label>
                        <textarea class="form-control lg-input"
                                  rows="3"
                                  v-model="form.olcekMaddesi"
                                  placeholder="Ölçek maddesini giriniz..."></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Soru Metni</label>
                        <textarea class="form-control lg-input"
                                  rows="5"
                                  v-model="form.soruMetni"
                                  placeholder="Soru metnini giriniz..."></textarea>
                    </div>
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <label class="form-label mb-1">Cevap Şıkları</label>
                                <div class="mini-muted">
                                    Şık harfleri otomatik oluşturulur. En az 2 cevap şıkkı olmalıdır.
                                </div>
                            </div>
                        </div>

                        <div v-for="(answer, index) in form.cevaplar"
                             :key="index"
                             class="answer-row">

                            <div class="answer-letter">
                                {{ answer.key }}
                            </div>

                            <input class="form-control lg-input answer-input"
                                   v-model="answer.value"
                                   :placeholder="answer.key + ' şıkkının cevap metni'" />

                            <button class="answer-remove-btn"
                                    type="button"
                                    @@click="removeAnswer(index)"
                                    :disabled="form.cevaplar.length <= 2">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>

                        <button class="answer-add-row"
                                type="button"
                                @@click="addAnswer">
                            <div class="answer-letter">
                                <i class="fa fa-plus"></i>
                            </div>

                            <span>Yeni şık ekle</span>
                        </button>
                    </div>

                    <div class="mb-3 mt-4">
                        <label class="form-label">Doğru Cevap</label>

                        <select class="form-control lg-input"
                                v-model="form.dogruCevap.key">
                            <option value="">Doğru cevabı seçiniz</option>

                            <option v-for="answer in form.cevaplar"
                                    :key="answer.key"
                                    :value="answer.key"
                                    :disabled="!answer.value">
                                {{ answer.key }} - {{ answer.value || 'Cevap metni girilmedi' }}
                            </option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Doğru Cevap Açıklaması</label>
                        <textarea class="form-control lg-input"
                                  rows="3"
                                  v-model="form.dogruCevap.explanation"
                                  placeholder="Doğru cevabın açıklamasını giriniz..."></textarea>
                    </div>

                    <button class="btn btn-lymph w-100"
                            type="button"
                            @@click="save">
                        <i class="fa fa-check-circle me-1"></i>
                        {{ isUpdate ? 'Soruyu Güncelle' : 'Soru Oluştur' }}
                    </button>

                    <button v-if="isUpdate"
                            class="btn btn-light w-100 rounded-pill mt-2"
                            type="button"
                            @@click="clearForm">
                        Vazgeç
                    </button>

                </div>
            </div>
        </div>

        <div class="glass-card">
            <div class="glass-card-header">
                <h5 class="section-title">
                    <i class="fa fa-list-check"></i>
                    Soru Listesi
                </h5>

                <p class="section-desc">
                    Eklenen soruları görüntüleyin, düzenleyin veya silin.
                </p>
            </div>

            <div class="glass-card-body">

                <div class="search-wrap mb-4">
                    <i class="fa fa-search"></i>
                    <input class="form-control lg-input"
                           v-model="search"
                           placeholder="Soru, hedef veya ölçek maddesine göre ara..." />
                </div>

                <div class="table-responsive">
                    <table class="table question-table">
                        <thead>
                            <tr>
                                <th>Soru</th>
                                <th>Hedef</th>
                                <th>Ölçek Maddesi</th>
                                <th>Doğru Cevap</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr v-for="item in pagedQuestions" :key="item.id">
                                <td>
                                    <div class="question-text">
                                        {{ item.soruMetni || '-' }}
                                    </div>
                                </td>

                                <td>
                                    <div class="table-long-text">
                                        {{ item.hedef || '-' }}
                                    </div>
                                </td>

                                <td>
                                    <div class="table-long-text">
                                        {{ item.olcekMaddesi || '-' }}
                                    </div>
                                </td>

                                <td>
                                    <span class="question-pill">
                                        <i class="fa fa-check"></i>
                                        {{ item.dogruCevap && item.dogruCevap.key ? item.dogruCevap.key : '-' }}
                                    </span>
                                </td>

                                <td class="text-end">
                                    <div class="d-flex justify-content-end flex-wrap gap-2">
                                        <button class="btn btn-sm btn-light rounded-pill px-3"
                                                type="button"
                                                @@click="edit(item)">
                                            <i class="fa fa-pen me-1"></i>
                                            Düzenle
                                        </button>

                                        <button class="btn btn-sm btn-danger rounded-pill px-3"
                                                type="button"
                                                @@click="deleteItem(item.id)">
                                            <i class="fa fa-trash me-1"></i>
                                            Sil
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            <tr v-if="pagedQuestions.length === 0">
                                <td colspan="5" class="text-center text-muted py-5">
                                    <i class="fa fa-circle-info me-1"></i>
                                    Henüz soru bulunamadı.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="pagination-wrap" v-if="totalPages > 1">
                    <button class="page-btn"
                            type="button"
                            @@click="changePage(currentPage - 1)"
                            :disabled="currentPage === 1">
                        <i class="fa fa-chevron-left"></i>
                    </button>

                    <button v-for="page in totalPages"
                            :key="page"
                            type="button"
                            class="page-btn"
                            :class="{ active: currentPage === page }"
                            @@click="changePage(page)">
                        {{ page }}
                    </button>

                    <button class="page-btn"
                            type="button"
                            @@click="changePage(currentPage + 1)"
                            :disabled="currentPage === totalPages">
                        <i class="fa fa-chevron-right"></i>
                    </button>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/page-js/soru/index.js"></script>
}