@{
    ViewData["Title"] = "Sorular";
}

<style>

    .content-type-card {
        min-height: 155px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        gap: 8px;
        padding: 22px;
        border: 2px solid #f2ddd0;
        border-radius: 20px;
        background: #fff;
        color: #2d2a28;
        text-align: left;
        transition: all .2s ease;
    }

        .content-type-card i {
            font-size: 26px;
            color: #c2410c;
        }

        .content-type-card strong {
            font-size: 16px;
            font-weight: 800;
        }

        .content-type-card small {
            font-size: 12px;
            color: #7a6d67;
            line-height: 1.5;
        }

        .content-type-card:hover {
            border-color: #fb923c;
            transform: translateY(-2px);
        }

        .content-type-card.active {
            border-color: #c2410c;
            background: linear-gradient(135deg, #fff7ed, #ffedd5);
            box-shadow: 0 12px 30px rgba(194, 65, 12, .12);
        }

            .content-type-card.active::after {
                content: "✓ Seçili";
                color: #c2410c;
                font-size: 12px;
                font-weight: 800;
            }

    :root {
        --lg-primary: #C2410C;
        --lg-primary-dark: #9A3412;
        --lg-secondary: #FB923C;
        --lg-accent: #FDBA74;
        --lg-bg: #FFF7F0;
        --lg-dark: #2D2A28;
        --lg-muted: #7A6D67;
        --lg-border: #F2DDD0;
    }

    .question-page {
        position: relative;
        min-height: calc(100vh - 90px);
        padding: 34px;
        overflow: hidden;
        background: radial-gradient(circle at top left, rgba(251,146,60,.18), transparent 35%), radial-gradient(circle at top right, rgba(194,65,12,.15), transparent 32%), linear-gradient(135deg, #FFF9F4 0%, #FFF3E8 45%, #FFFFFF 100%);
        border-radius: 32px;
    }

        .question-page::before {
            content: "";
            position: absolute;
            inset: 18px;
            border: 1px solid rgba(194,65,12,.10);
            border-radius: 28px;
            pointer-events: none;
        }

    .question-shell {
        position: relative;
        z-index: 1;
    }

    .question-hero {
        position: relative;
        z-index: 1;
        padding: 30px 34px;
        margin-bottom: 28px;
        border-radius: 30px;
        background: linear-gradient(135deg, #C2410C 0%, #EA580C 40%, #FB923C 100%);
        color: #fff;
        box-shadow: 0 22px 55px rgba(194,65,12,.28);
        overflow: hidden;
    }

        .question-hero::after {
            content: "";
            position: absolute;
            width: 330px;
            height: 330px;
            right: -120px;
            top: -150px;
            border-radius: 50%;
            background: rgba(255,255,255,.18);
        }

        .question-hero::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: 130px;
            bottom: -100px;
            border-radius: 50%;
            background: rgba(255,255,255,.12);
        }

    .hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        margin-bottom: 14px;
        border-radius: 999px;
        background: rgba(255,255,255,.18);
        font-size: 13px;
        font-weight: 700;
    }

    .hero-title {
        position: relative;
        z-index: 1;
        font-size: 34px;
        font-weight: 800;
        margin-bottom: 8px;
        letter-spacing: -.5px;
    }

    .hero-subtitle {
        position: relative;
        z-index: 1;
        max-width: 760px;
        margin: 0;
        opacity: .94;
        font-size: 15px;
    }

    .glass-card,
    .lg-card {
        border: 1px solid rgba(255,255,255,.72);
        border-radius: 28px;
        background: rgba(255,255,255,.82);
        box-shadow: 0 22px 46px rgba(194,65,12,.08);
        backdrop-filter: blur(16px);
        overflow: hidden;
    }

    .glass-card-header,
    .lg-card-header {
        padding: 24px 26px 12px;
        border-bottom: 1px solid rgba(242,221,208,.80);
        background: linear-gradient(180deg, rgba(255,255,255,.90), rgba(255,247,240,.62));
    }

    .glass-card-body,
    .lg-card-body {
        padding: 24px 26px 28px;
    }

    .accordion-head {
        width: 100%;
        border: 0;
        padding: 24px 26px;
        background: linear-gradient(180deg, rgba(255,255,255,.94), rgba(255,243,232,.70));
        display: flex;
        justify-content: space-between;
        align-items: center;
        text-align: left;
    }

    .accordion-arrow {
        width: 42px;
        height: 42px;
        min-width: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        color: var(--lg-primary);
        background: rgba(194,65,12,.10);
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--lg-dark);
        font-weight: 800;
        margin-bottom: 6px;
    }

        .section-title i {
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            color: #fff;
            background: linear-gradient(135deg, var(--lg-primary), var(--lg-secondary));
            box-shadow: 0 10px 22px rgba(194,65,12,.22);
        }

    .section-desc {
        color: var(--lg-muted);
        font-size: 14px;
        margin: 0;
    }

    .form-label {
        color: #3A302B;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .lg-input {
        min-height: 48px;
        border-radius: 16px;
        border: 1px solid var(--lg-border);
        background: rgba(255,255,255,.94);
        padding: 12px 15px;
        color: var(--lg-dark);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
    }

    textarea.lg-input {
        resize: vertical;
        line-height: 1.55;
    }

    .lg-input:focus {
        border-color: var(--lg-primary);
        box-shadow: 0 0 0 .20rem rgba(194,65,12,.16);
    }

    .upload-zone {
        position: relative;
        border: 1.5px dashed rgba(194,65,12,.32);
        border-radius: 22px;
        padding: 22px;
        background: linear-gradient(135deg, rgba(194,65,12,.05), rgba(251,146,60,.10));
        transition: .2s ease;
    }

        .upload-zone:hover {
            transform: translateY(-1px);
            border-color: var(--lg-primary);
            box-shadow: 0 16px 34px rgba(194,65,12,.10);
        }

    .upload-icon {
        width: 48px;
        height: 48px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(135deg, var(--lg-primary), var(--lg-secondary));
        box-shadow: 0 12px 24px rgba(194,65,12,.22);
    }

    .answer-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }

    .answer-letter {
        width: 52px;
        height: 52px;
        min-width: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: linear-gradient(135deg, #C2410C, #FB923C);
        color: white;
        font-size: 18px;
        font-weight: 800;
        box-shadow: 0 8px 20px rgba(194,65,12,.22);
    }

    .answer-input {
        height: 52px;
        border-radius: 16px;
    }

    .answer-add-row {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 12px;
        border: 1.5px dashed rgba(194,65,12,.30);
        border-radius: 18px;
        padding: 10px;
        background: rgba(255,255,255,.70);
        color: var(--lg-primary);
        font-weight: 800;
        transition: .2s ease;
    }

        .answer-add-row:hover {
            transform: translateY(-1px);
            border-color: var(--lg-primary);
            background: rgba(194,65,12,.06);
        }

    .answer-remove-btn {
        width: 44px;
        height: 44px;
        min-width: 44px;
        border: 0;
        border-radius: 14px;
        color: #fff;
        background: #dc3545;
    }

        .answer-remove-btn:disabled {
            opacity: .35;
            cursor: not-allowed;
        }

    .btn-lymph {
        border: 0;
        border-radius: 999px;
        padding: 13px 24px;
        color: #fff;
        font-weight: 800;
        background: linear-gradient(135deg, var(--lg-primary), var(--lg-secondary));
        box-shadow: 0 14px 28px rgba(194,65,12,.24);
        transition: .2s ease;
    }

        .btn-lymph:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 18px 34px rgba(194,65,12,.30);
        }

    .search-wrap {
        position: relative;
    }

        .search-wrap i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--lg-muted);
        }

        .search-wrap input {
            padding-left: 44px;
        }

    .question-table {
        border-collapse: separate;
        border-spacing: 0 12px;
    }

        .question-table thead th {
            border: 0;
            color: var(--lg-muted);
            font-size: 12px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .4px;
            padding: 0 16px 8px;
            white-space: nowrap;
        }

        .question-table tbody tr {
            background: rgba(255,255,255,.88);
            box-shadow: 0 10px 24px rgba(194,65,12,.06);
        }

        .question-table tbody td {
            border: 0;
            padding: 18px 16px;
            vertical-align: middle;
        }

            .question-table tbody td:first-child {
                border-top-left-radius: 20px;
                border-bottom-left-radius: 20px;
            }

            .question-table tbody td:last-child {
                border-top-right-radius: 20px;
                border-bottom-right-radius: 20px;
            }

    .question-text {
        color: var(--lg-dark);
        font-weight: 800;
        max-width: 420px;
        white-space: normal;
    }

    .table-long-text {
        max-width: 340px;
        color: var(--lg-muted);
        white-space: normal;
    }

    .question-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(194,65,12,.10);
        color: var(--lg-primary);
        font-weight: 900;
        font-size: 13px;
    }

    .mini-muted {
        color: var(--lg-muted);
        font-size: 13px;
        margin-top: 5px;
    }

    .pagination-wrap {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 18px;
    }

    .page-btn {
        min-width: 40px;
        height: 40px;
        border: 1px solid rgba(194,65,12,.18);
        border-radius: 14px;
        background: #fff;
        color: var(--lg-primary);
        font-weight: 800;
    }

        .page-btn.active {
            color: #fff;
            background: linear-gradient(135deg, var(--lg-primary), var(--lg-secondary));
            box-shadow: 0 12px 24px rgba(194,65,12,.22);
        }

        .page-btn:disabled {
            opacity: .4;
            cursor: not-allowed;
        }

    .file-info-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 18px;
        background: rgba(255,255,255,.78);
        border: 1px solid rgba(194,65,12,.14);
    }

        .file-info-card.selected {
            background: rgba(251,146,60,.12);
            border-color: rgba(251,146,60,.25);
        }

    .file-info-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(135deg, var(--lg-primary), var(--lg-secondary));
    }

    .file-info-title {
        font-size: 12px;
        font-weight: 800;
        color: var(--lg-dark);
    }

    .file-info-text {
        font-size: 13px;
        color: var(--lg-muted);
        word-break: break-all;
    }

    .custom-accordion-button {
        background: linear-gradient(135deg, rgba(194,65,12,.08), rgba(251,146,60,.12));
        color: var(--lg-primary);
        border: 0;
        padding: 22px 26px;
        box-shadow: none !important;
    }

        .custom-accordion-button:not(.collapsed) {
            background: linear-gradient(135deg, var(--lg-primary), var(--lg-secondary));
            color: #fff;
        }

            .custom-accordion-button:not(.collapsed) .text-muted {
                color: rgba(255,255,255,.85) !important;
            }

        .custom-accordion-button::after {
            filter: hue-rotate(310deg) saturate(1.4);
        }

        .custom-accordion-button:not(.collapsed)::after {
            filter: brightness(0) invert(1);
        }

    .cke_chrome {
        border: 1px solid rgba(194,65,12,.22) !important;
        border-radius: 18px !important;
        overflow: hidden;
        box-shadow: 0 14px 28px rgba(194,65,12,.08) !important;
    }

    .cke_top {
        background: linear-gradient(135deg, #FFF3E8, #FFF9F4) !important;
        border-bottom: 1px solid rgba(194,65,12,.18) !important;
    }

    .cke_bottom {
        background: #FFF7F0 !important;
        border-top: 1px solid rgba(194,65,12,.16) !important;
    }

    .cke_toolgroup {
        border: 1px solid rgba(194,65,12,.16) !important;
        border-radius: 12px !important;
        background: #ffffff !important;
    }

    .cke_button:hover,
    .cke_button:focus,
    .cke_button_on {
        background: rgba(194,65,12,.12) !important;
        border-radius: 8px !important;
    }

    .cke_combo_button {
        border: 1px solid rgba(194,65,12,.18) !important;
        border-radius: 12px !important;
        background: #ffffff !important;
    }

    .cke_contents {
        background: #ffffff !important;
    }

    @@media(max-width: 992px) {
        .question-page {
            padding: 18px;
            border-radius: 22px;
        }

        .question-hero {
            padding: 24px;
        }

        .hero-title {
            font-size: 26px;
        }

        .answer-row {
            align-items: stretch;
        }
    }

    .answer-editor {
        border: 1px solid var(--lg-border);
        border-radius: 18px;
        background: rgba(255,255,255,.86);
        padding: 16px;
        margin-bottom: 14px;
    }

        .answer-editor .answer-row {
            margin-bottom: 8px;
        }

    .answer-explanation {
        margin-left: 64px;
    }

    .answer-correct-note {
        margin-left: 64px;
        padding: 12px;
        border-radius: 12px;
        color: #166534;
        background: #f0fdf4;
        font-size: 13px;
    }

    @@media(max-width: 600px) {
        .answer-explanation, .answer-correct-note {
            margin-left: 0;
        }
    }

    .content-filter-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 18px;
        border: 1px solid #f2ddd0;
        border-radius: 14px;
        background: #fff;
        color: #9a3412;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: all .2s ease;
    }

        .content-filter-btn:hover {
            background: #fff7ed;
            border-color: #fb923c;
            transform: translateY(-1px);
        }

        .content-filter-btn.active {
            background: linear-gradient(135deg, #c2410c, #fb923c);
            border-color: transparent;
            color: #fff;
            box-shadow: 0 8px 18px rgba(194, 65, 12, .20);
        }

</style>
<div id="app" class="question-page mb-5 mt-1">
    @Html.AntiForgeryToken()

    <div class="question-hero">
        <div class="hero-kicker">
            <i class="fa fa-shield-heart"></i>
            Eğitim İçerik Yönetimi
        </div>

        <h1 class="hero-title">Soru Yönetimi</h1>

        <p class="hero-subtitle">
            Videoya bağlı soruları oluşturun, cevap şıklarını yönetin ve doğru cevap açıklamalarını tek ekrandan düzenleyin.
        </p>
    </div>

    <div class="question-shell">
        <div class="lg-card mb-4">
            <div class="lg-card-header">
                <h5 class="section-title">
                    <i class="fa fa-circle-info me-2 text-info"></i>
                    Ön Bilgilendirme Metni
                </h5>
                <p class="section-desc">
                    Mobil uygulamada simülasyon başlamadan önce kullanıcıya gösterilecek bilgilendirme metnini buradan düzenleyin.
                </p>
            </div>

            <div class="lg-card-body">

                <div class="row mb-3">
                    <div>
                        <textarea required name="editor1" id="editor1" rows="10" cols="80"> </textarea>
                    </div>
                </div>
                <button class="btn btn-lymph mt-3"
                        type="button"
                        @@click="saveOnBilgilendirme">
                    <i class="fa fa-save me-1"></i>
                    Ön Bilgilendirmeyi Kaydet
                </button>
            </div>
        </div>
        <div class="mb-4" id="questionFormArea">
            <div class="glass-card">

                <button class="accordion-head"
                        type="button"
                        @@click="formAccordionOpen = !formAccordionOpen">
                    <div>
                        <h5 class="section-title mb-1">
                            <i class="fa fa-circle-question"></i>
                            {{ isUpdate ? 'Soru Güncelle' : 'Yeni Soru Oluştur' }}
                        </h5>

                        <p class="section-desc">
                            Video, hedef, ölçek maddesi, soru metni, cevap şıkları ve yanlış yanıt gerekçelerini giriniz.
                        </p>
                    </div>

                    <div class="accordion-arrow">
                        <i class="fa"
                           :class="formAccordionOpen ? 'fa-chevron-up' : 'fa-chevron-down'"></i>
                    </div>
                </button>

                <div v-show="formAccordionOpen" class="glass-card-body">
                    <div class="mb-4">
                        <label class="form-label mb-3">
                            İçerik Türü
                        </label>

                        <div class="row g-3">

                            <div class="col-md-4">
                                <button type="button"
                                        class="content-type-card w-100"
                                        :class="{ active: icerikTuru === 'video' }"
                                        @@click="icerikTuruDegistir('video')">

                                    <i class="fa fa-video mb-2"></i>

                                    <strong>Sadece Video</strong>

                                    <small>
                                        Soru olmadan video içeriği oluştur.
                                    </small>
                                </button>
                            </div>

                            <div class="col-md-4">
                                <button type="button"
                                        class="content-type-card w-100"
                                        :class="{ active: icerikTuru === 'soru' }"
                                        @@click="icerikTuruDegistir('soru')">

                                    <i class="fa fa-circle-question mb-2"></i>

                                    <strong>Sadece Soru</strong>

                                    <small>
                                        Video olmadan soru oluştur.
                                    </small>
                                </button>
                            </div>

                            <div class="col-md-4">
                                <button type="button"
                                        class="content-type-card w-100"
                                        :class="{ active: icerikTuru === 'videoSoru' }"
                                        @@click="icerikTuruDegistir('videoSoru')">

                                    <i class="fa fa-clapperboard mb-2"></i>

                                    <strong>Video + Soru</strong>

                                    <small>
                                        Video ve soruyu birlikte oluştur.
                                    </small>
                                </button>
                            </div>

                        </div>
                    </div>

                    <div class="mb-4" v-if="icerikTuru !== 'soru'">
                        <label class="form-label">Video Dosyası</label>

                        <div class="upload-zone">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="upload-icon">
                                    <i class="fa fa-cloud-arrow-up"></i>
                                </div>

                                <div>
                                    <strong>{{ isUpdate ? 'Video güncelle' : 'Video yükleyin' }}</strong>
                                    <div class="text-muted small">
                                        MP4, MOV veya desteklenen video formatları
                                    </div>
                                </div>
                            </div>

                            <input class="form-control"
                                   type="file"
                                   accept="video/*"
                                   @@change="handleVideoFile" />

                            <div v-if="isUpdate && form.videoPath" class="file-info-card mt-3">
                                <div class="file-info-icon">
                                    <i class="fa fa-video"></i>
                                </div>

                                <div>
                                    <div class="file-info-title">Mevcut video</div>
                                    <div class="file-info-text">{{ getFileName(form.videoPath) }}</div>
                                </div>
                            </div>

                            <div v-if="form.videoFile" class="file-info-card selected mt-3">
                                <div class="file-info-icon">
                                    <i class="fa fa-file-video"></i>
                                </div>

                                <div>
                                    <div class="file-info-title">Yeni seçilen dosya</div>
                                    <div class="file-info-text">{{ form.videoFile.name }}</div>
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Video Transcript</label>
                            <textarea class="form-control lg-input"
                                      rows="6"
                                      v-model="form.videoTranscript"
                                      placeholder="Video bittikten sonra mobilde gösterilecek transcript metnini giriniz..."></textarea>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Bekleme Süresi (Saniye)</label>

                                <input type="number"
                                       class="form-control lg-input"
                                       v-model.number="form.beklemeSuresi"
                                       min="0"
                                       step="1"
                                       placeholder="Örn: 120" />
                            </div>

                            <div class="col-md-8">
                                <label class="form-label">Bildirim Metni</label>

                                <textarea class="form-control lg-input"
                                          rows="3"
                                          v-model="form.bildirimMetni"
                                          placeholder="Örn: Hastanın pansuman saati gelmiştir. Saat: 21:00."></textarea>
                            </div>
                        </div>

                    </div>

                    <div class="mb-3" v-if="isUpdate">
                        <label class="form-label">Order (İçerik Sırası)</label>

                        <input type="number"
                               class="form-control lg-input"
                               min="1"
                               step="1"
                               v-model.number="form.order" />

                        <small class="text-muted">
                            İçeriğin senaryo içerisindeki sırasını belirler.
                        </small>
                    </div>

                    <div v-if="icerikTuru !== 'video'">
                        <div class="mb-3">
                            <label class="form-label">Hedef</label>
                            <textarea class="form-control lg-input"
                                      rows="3"
                                      v-model="form.hedef"
                                      placeholder="Hedef metnini giriniz..."></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ölçek Maddesi</label>
                            <textarea class="form-control lg-input"
                                      rows="3"
                                      v-model="form.olcekMaddesi"
                                      placeholder="Ölçek maddesini giriniz..."></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Soru Metni</label>
                            <textarea class="form-control lg-input"
                                      rows="5"
                                      v-model="form.soruMetni"
                                      placeholder="Soru metnini giriniz..."></textarea>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="acikUcluSoru"
                                   v-model="form.acikUcluMu" />

                            <label class="form-check-label fw-bold" for="acikUcluSoru">
                                Açık Uçlu Soru
                            </label>
                        </div>

                        <div class="mb-4" v-if="!form.acikUcluMu">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <label class="form-label mb-1">Cevap Şıkları</label>
                                    <div class="mini-muted">
                                        Şık harfleri otomatik oluşturulur. En az 2 cevap şıkkı olmalıdır.
                                    </div>
                                </div>
                            </div>


                            <div v-for="(answer, index) in form.cevaplar"
                                 :key="index"
                                 class="answer-editor"
                                 :style="form.dogruCevap.key === answer.key
         ? 'border:2px solid #198754;background:#f0fdf4;'
         : ''">

                                <div class="answer-row">

                                    <div class="answer-letter">
                                        {{ answer.key }}
                                    </div>

                                    <input class="form-control lg-input answer-input"
                                           v-model="answer.value"
                                           :placeholder="answer.key + ' şıkkının cevap metni'" />

                                    <button class="answer-remove-btn"
                                            type="button"
                                            @@click="removeAnswer(index)"
                                            :disabled="form.cevaplar.length <= 2">
                                        <i class="fa fa-trash"></i>
                                    </button>

                                </div>

                                <!-- Doğru cevap seçimi -->
                                <div class="form-check mb-3 ms-2">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="dogruCevapSecimi"
                                           :id="'dogruCevap_' + index"
                                           :value="answer.key"
                                           v-model="form.dogruCevap.key" />

                                    <label class="form-check-label fw-bold"
                                           :for="'dogruCevap_' + index">
                                        Doğru cevap olarak işaretle
                                    </label>
                                </div>

                                <!-- Doğru cevap -->
                                <div v-if="form.dogruCevap.key === answer.key"
                                     class="answer-correct-note">

                                    <i class="fa fa-check-circle me-1"></i>
                                    Bu şık doğru cevap olarak seçildi.

                                </div>

                                <!-- Yanlış cevap -->
                                <div v-else class="answer-explanation">

                                    <label class="form-label">
                                        {{ answer.key }} Şıkkı - Yanlış Cevap Gerekçesi
                                    </label>

                                    <textarea class="form-control lg-input"
                                              rows="3"
                                              v-model="answer.explanation"
                                              :placeholder="answer.key + ' şıkkının neden yanlış olduğunu açıklayın...'"></textarea>

                                </div>

                            </div>


                            <button class="answer-add-row"
                                    type="button"
                                    @@click="addAnswer">
                                <div class="answer-letter">
                                    <i class="fa fa-plus"></i>
                                </div>

                                <span>Yeni şık ekle</span>
                            </button>
                        </div>
                    </div>

                    <button class="btn btn-lymph w-100"
                            type="button"
                            @@click="save">
                        <i class="fa fa-check-circle me-1"></i>
                        {{ isUpdate ? 'İçeriği Güncelle' : 'İçeriği Kaydet' }}
                    </button>

                    <button v-if="isUpdate"
                            class="btn btn-light w-100 rounded-pill mt-2"
                            type="button"
                            @@click="clearForm">
                        Vazgeç
                    </button>

                </div>
            </div>
            <br />
            <div class="glass-card">
                <div class="glass-card-header">
                    <h5 class="section-title">
                        <i class="fa fa-list-check"></i>
                        İçerik Listesi
                    </h5>

                    <p class="section-desc">
                        Eklenen soruları görüntüleyin, düzenleyin veya silin.
                    </p>
                </div>

                <div class="glass-card-body">

                    <div class="row g-3 mb-4 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label">İçerik Ara</label>
                            <div class="search-wrap">
                                <i class="fa fa-search"></i>
                                <input class="form-control lg-input"
                                       v-model="search"
                                       placeholder="Soru, hedef veya ölçek maddesine göre ara..." />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="listContentFilter">İçerik Türü</label>


                                <div class="d-flex flex-wrap gap-2">

                                    <button type="button"
                                            class="content-filter-btn"
                                            :class="{ active: icerikFiltresi === 'tumu' }"
                                            @@click="icerikFiltresi = 'tumu'">
                                        <i class="fa fa-layer-group me-2"></i>
                                        Tümü
                                    </button>

                                    <button type="button"
                                            class="content-filter-btn"
                                            :class="{ active: icerikFiltresi === 'video' }"
                                            @@click="icerikFiltresi = 'video'">
                                        <i class="fa fa-video me-2"></i>
                                        Sadece Video
                                    </button>

                                    <button type="button"
                                            class="content-filter-btn"
                                            :class="{ active: icerikFiltresi === 'soru' }"
                                            @@click="icerikFiltresi = 'soru'">
                                        <i class="fa fa-circle-question me-2"></i>
                                        Sadece Soru
                                    </button>

                                    <button type="button"
                                            class="content-filter-btn"
                                            :class="{ active: icerikFiltresi === 'videoSoru' }"
                                            @@click="icerikFiltresi = 'videoSoru'">
                                        <i class="fa fa-clapperboard me-2"></i>
                                        Video + Soru
                                    </button>

                                </div>

                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table question-table">

                            <thead>
                                <tr>
                                    <th>İçerik Türü</th>
                                    <th>İçerik Bilgisi</th>
                                    <th>Hedef</th>
                                    <th>Bekleme Süresi</th>
                                    <th>Doğru Cevap</th>
                                    <th class="text-end">İşlemler</th>
                                </tr>
                            </thead>


                            <tbody>

                                <tr v-for="item in pagedQuestions" :key="item.id">

                                    <td>
                                        <span class="question-pill"
                                              v-if="item.videoPath && item.soruMetni">
                                            <i class="fa fa-clapperboard me-1"></i>
                                            Video + Soru
                                        </span>

                                        <span class="question-pill"
                                              v-else-if="item.videoPath">
                                            <i class="fa fa-video me-1"></i>
                                            Video
                                        </span>

                                        <span class="question-pill" v-else>
                                            <i class="fa fa-circle-question me-1"></i>
                                            Soru
                                        </span>
                                    </td>

                                    <td>
                                        <div class="question-text"
                                             v-if="item.soruMetni">
                                            {{ item.soruMetni }}
                                        </div>

                                        <div v-else-if="item.videoPath">
                                            <div class="fw-bold">
                                                <i class="fa fa-film me-1"></i>
                                                Video İçeriği
                                            </div>

                                            <div class="mini-muted">
                                                {{ getFileName(item.videoPath) }}
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="table-long-text">
                                            {{ item.hedef || 'Belirtilmedi' }}
                                        </div>
                                    </td>

                                    <td>
                                        <span v-if="item.beklemeSuresi > 0">
                                            {{ item.beklemeSuresi }} saniye
                                        </span>

                                        <span v-else class="text-muted">
                                            Bekleme yok
                                        </span>
                                    </td>

                                    <td>
                                        <span v-if="item.soruMetni"
                                              class="question-pill">
                                            <i class="fa fa-check me-1"></i>
                                            {{ item.dogruCevap?.key || '-' }}
                                        </span>

                                        <span v-else class="text-muted">
                                            Soru bulunmuyor
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <div class="d-flex justify-content-end flex-wrap gap-2">

                                            <button class="btn btn-sm btn-light rounded-pill px-3"
                                                    type="button"
                                                    @@click="edit(item)">
                                                <i class="fa fa-pen me-1"></i>
                                                Düzenle
                                            </button>

                                            <button class="btn btn-sm btn-danger rounded-pill px-3"
                                                    type="button"
                                                    @@click="deleteItem(item.id)">
                                                <i class="fa fa-trash me-1"></i>
                                                Sil
                                            </button>

                                        </div>
                                    </td>
                                </tr>

                                <tr v-if="pagedQuestions.length === 0">
                                    <td colspan="6" class="text-center text-muted py-5">
                                        <i class="fa fa-circle-info me-1"></i>
                                        Henüz soru bulunamadı.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="pagination-wrap" v-if="totalPages > 1">
                        <button class="page-btn"
                                type="button"
                                @@click="changePage(currentPage - 1)"
                                :disabled="currentPage === 1">
                            <i class="fa fa-chevron-left"></i>
                        </button>

                        <template v-for="page in visiblePages" :key="page">
                            <span v-if="typeof page === 'string'"
                                  class="d-inline-flex align-items-center px-1 text-muted">…</span>
                            <button v-else
                                    type="button"
                                    class="page-btn"
                                    :class="{ active: currentPage === page }"
                                    @@click="changePage(page)">
                                {{ page }}
                            </button>
                        </template>

                        <button class="page-btn"
                                type="button"
                                @@click="changePage(currentPage + 1)"
                                :disabled="currentPage === totalPages">
                            <i class="fa fa-chevron-right"></i>
                        </button>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section Scripts {
        <script src="~/ckeditor4/ckeditor.js"></script>


        <script src="~/page-js/soru/index.js"></script>
    }
